  "triggers": [
    {
      "id": "end_of_support", "name": "Version approaching end of support", "relevance": "Very high",
      "action": "Identify customers facing upgrade decisions",
      "all": [["end of support", "end of life", "end-of-life", "retire*", "no longer supported", "support ends", "support will end", "mandatory upgrade", "upgrade deadline", "sunset*", "discontinu*", "withdrawn"]]
    },
    {
      "id": "acquisition", "name": "Company acquires another business", "relevance": "Very high",
      "action": "Investigate multi-entity reporting and consolidation",
      "all": [["acquire*", "acquisition*", "merger", "merges", "merged", "takeover", "takes over", "buys", "bought"]]
    },
    {
      "id": "new_fd", "name": "Company appoints new FD/CFO", "relevance": "Very high",
      "action": "Approach during potential finance transformation review",
      "all": [
        ["CFO", "chief financial officer", "finance director", "FD", "financial controller", "head of finance"],
        ["appoint*", "join*", "hire*", "welcome*", "new", "promot*", "named"]
      ]
    },
    {
      "id": "price_increase", "name": "Finance system price increase", "relevance": "High",
      "action": "Compare total cost of ownership",
      "all": [["price increase*", "price rise*", "price hike*", "pricing change*", "new pricing", "increase* prices", "raising prices", "licence cost*", "subscription cost*"]]
    },
    {
      "id": "migration", "name": "Legacy finance system migration", "relevance": "High",
